NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Cloudflare Turnstile site key [OPCIONAL] — sem essa, o widget de CAPTCHA
# não é renderizado (o backend também pula a verificação sem
# TURNSTILE_SECRET_KEY). O site key é público por natureza, não é segredo.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
