NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Cloudflare Turnstile site key [OPCIONAL] — sem essa, o widget de CAPTCHA
# não é renderizado (o backend também pula a verificação sem
# TURNSTILE_SECRET_KEY). O site key é público por natureza, não é segredo.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Google Analytics 4 [OPCIONAL] — sem essa, nenhum script de analytics é
# carregado. Formato G-XXXXXXXXXX, criado em analytics.google.com.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Chave pública VAPID [OPCIONAL] — sem essa, o botão "Ativar notificações
# neste dispositivo" não aparece. Mesmo valor de VAPID_PUBLIC_KEY no
# .env do backend; gere o par com `vapid --gen` (pacote pywebpush).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
