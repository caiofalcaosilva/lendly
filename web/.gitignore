# Env files — never commit secrets
.env
.env.local
.env.*.local

# Python cache
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/
env/

# Ruff / mypy
.ruff_cache/
.mypy_cache/

# Local file uploads (not in a docker volume, unlike uploads/) — CPF
# documents and selfies must never be committed.
verification_uploads/

# Files written by image-upload tests run locally (outside Docker, where
# uploads/ is a named volume instead of a bind mount).
uploads/

# Misc
.DS_Store
