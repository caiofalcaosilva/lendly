# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=lendly

# Auth — troque SECRET_KEY antes de rodar qualquer coisa parecida com produção
SECRET_KEY=changeme-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# E-mail (SMTP) — os valores abaixo funcionam com o MailHog do docker-compose
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@lendly.app
SMTP_TLS=false
EMAIL_VERIFICATION_EXPIRE_HOURS=24

# App
FRONTEND_URL=http://localhost:3000
TOTP_ISSUER=Lendly
# Base para URLs absolutas de fotos — use http://10.0.2.2:8000 no emulador Android
API_PUBLIC_URL=http://localhost:8000

# Criptografia dos tokens do Mercado Pago em repouso (chave Fernet, 32 bytes
# base64 — gere com Fernet.generate_key()). Troque antes de produção.
ENCRYPTION_KEY=changeme-32-byte-fernet-key-base64==

# Mercado Pago — deixe em branco em dev; pagamento fica inerte sem isso
MP_APP_ID=
MP_CLIENT_SECRET=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
PLATFORM_FEE_PERCENT=0.05

# Deixe true pra rodar um piloto só com empréstimo gratuito (sem aluguel
# pago) — útil antes de ter CNPJ pro split de pagamento do Mercado Pago.
# Bloqueia criar/editar item como pago na API, independente do que o
# frontend mostra. Volte pra false quando o pagamento estiver liberado.
FREE_LENDING_ONLY=false
