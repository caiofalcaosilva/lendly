# Copie pra .env e preencha: cp .env.example .env
# [OBRIGATÓRIO] = troque antes de produção (o app recusa iniciar com o
# valor de exemplo). [OPCIONAL] = pode ficar em branco, a feature
# correspondente só fica inerte até ser preenchida.

# ── Banco de dados ──────────────────────────────────────────────────────
# String de conexão do MongoDB. Em produção (Atlas), use o formato
# mongodb+srv://... — TLS já vem implícito nesse protocolo, sem precisar
# de flag extra. Localmente (mongodb:// puro, sem TLS) é o esperado.
MONGODB_URL=mongodb://localhost:27017
# Nome do banco dentro dessa instância.
MONGODB_DB=lendly

# ── Autenticação [OBRIGATÓRIO trocar antes de produção] ─────────────────
# Assina os tokens JWT (acesso e refresh) — qualquer um com essa chave
# consegue forjar um login.
SECRET_KEY=changeme-in-production
# Algoritmo de assinatura do JWT.
ALGORITHM=HS256
# Minutos até o access token expirar (o refresh token renova sozinho).
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Dias até a sessão (refresh token) expirar de vez, exigindo login de novo.
REFRESH_TOKEN_EXPIRE_DAYS=30
# Chave Fernet (32 bytes base64 — gere com Fernet.generate_key()) que
# criptografa os tokens OAuth do Mercado Pago em repouso no banco.
ENCRYPTION_KEY=changeme-32-byte-fernet-key-base64==

# ── E-mail ────────────────────────────────────────────────────────────────
# Servidor SMTP — os valores abaixo já funcionam com o MailHog do
# docker-compose (captura tudo localmente, não envia de verdade).
SMTP_HOST=mailhog
SMTP_PORT=1025
# Usuário/senha do SMTP — em branco funciona com o MailHog local.
SMTP_USER=
SMTP_PASS=
# Endereço que aparece como remetente nos e-mails enviados.
SMTP_FROM=noreply@lendly.com.br
# STARTTLS — precisa ser true com Resend/porta 587, senão o login SMTP
# falha com "Must issue a STARTTLS command first".
SMTP_TLS=false
# [OPCIONAL] Chave da API HTTP da Resend — quando preenchida, substitui o
# SMTP acima inteiro (Render e a maioria das hospedagens bloqueiam porta
# SMTP de saída; a API da Resend usa HTTP/443, que nunca é bloqueado).
RESEND_API_KEY=
# Horas até o link de verificação de e-mail expirar.
EMAIL_VERIFICATION_EXPIRE_HOURS=24

# ── App ───────────────────────────────────────────────────────────────────
# URL(s) do frontend — usada pra CORS e pra montar links dentro dos
# e-mails. Aceita várias separadas por vírgula (ex: testar pelo celular na
# mesma rede).
FRONTEND_URL=http://localhost:3000
# Nome do app mostrado no autenticador (Google Authenticator etc.) quando
# o usuário ativa o 2FA.
TOTP_ISSUER=Lendly
# Base pra montar URL absoluta das fotos enviadas pela API. Use
# http://10.0.2.2:8000 no emulador Android.
API_PUBLIC_URL=http://localhost:8000

# ── Login com Google [OPCIONAL] ──────────────────────────────────────────
# Client ID e Secret do OAuth Client criado no Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL de callback do fluxo de LOGIN (existe uma segunda, separada, pro
# fluxo de "conectar Google" no perfil: /auth/google/connect/callback) —
# as duas precisam estar cadastradas como redirect URI no Cloud Console,
# em dev e produção (4 URIs no total).
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ── Verificação de telefone por SMS [OPCIONAL] ───────────────────────────
# Sem essas 3, o código de verificação só é logado (não enviado de
# verdade) — dá pra testar o fluxo inteiro sem conta Twilio real.
# Account SID e Auth Token do painel da Twilio (console.twilio.com).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número remetente no formato E.164 (ex: +15551234567). Atenção: enviar
# SMS pro Brasil pela Twilio normalmente exige um número brasileiro
# registrado (compra + validação de empresa no painel deles) — um número
# americano comum costuma ser bloqueado pelas operadoras daqui. Vale
# considerar a API do WhatsApp da própria Twilio como alternativa se a
# aprovação de SMS brasileiro emperrar.
TWILIO_FROM_NUMBER=

# ── Mercado Pago (pagamento) [OPCIONAL] ──────────────────────────────────
# Ver docs/pagamento-online.md pra como obter cada um destes.
# ID da aplicação no painel do Mercado Pago.
MP_APP_ID=
# Client Secret — usado pra trocar/renovar o token OAuth de cada vendedor
# conectado.
MP_CLIENT_SECRET=
# Access token da própria conta da plataforma (não do vendedor).
MP_ACCESS_TOKEN=
# Segredo usado pra validar a assinatura HMAC dos webhooks recebidos.
MP_WEBHOOK_SECRET=
# Comissão do Lendly sobre cada aluguel pago, descontada do repasse do
# dono.
PLATFORM_FEE_PERCENT=0.05
# Taxa do fundo de garantia — cobrada em cima do valor bruto (paga pelo
# solicitante, não toca o repasse do dono), só em itens com valor
# declarado.
GUARANTEE_FEE_PERCENT=0.03
# true roda um piloto só com empréstimo gratuito (sem aluguel pago) — útil
# antes de ter CNPJ pro split do Mercado Pago. Bloqueia criar/editar item
# como pago na API, independente do que o frontend mostra.
FREE_LENDING_ONLY=false

# ── Cloudflare R2 (armazenamento de fotos/documentos) [OPCIONAL] ────────
# Em branco, uploads ficam em disco local (uploads/,
# verification_uploads/) — não sobrevive a um redeploy na maioria das
# hospedagens. Preencha os quatro antes de subir em qualquer lugar com
# disco temporário (Render, Railway, etc.).
# ID da conta Cloudflare.
R2_ACCOUNT_ID=
# Chave de acesso (API token) do bucket R2.
R2_ACCESS_KEY_ID=
# Segredo correspondente à chave de acesso acima.
R2_SECRET_ACCESS_KEY=
# Nome do bucket onde as imagens são salvas.
R2_BUCKET_NAME=
# URL pública do bucket (a URL r2.dev, ou domínio próprio apontado pra
# ele) — só pros uploads públicos (avatar/item/grupo); documentos de
# verificação são privados e usam link assinado, não essa URL.
R2_PUBLIC_URL=
